{
  "name": "Anthares Chrome remoto privado (Kwai + TikTok, sem Android)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/kwai-install.sh",
  "postStartCommand": "python control_plane/persistence_probe.py kwai && bash .devcontainer/kwai-start.sh",
  "forwardPorts": [
    6080,
    8765,
    8766
  ],
  "portsAttributes": {
    "6080": {
      "label": "Anthares Chrome remoto (noVNC, acesso privado)",
      "onAutoForward": "notify",
      "protocol": "http",
      "visibility": "private"
    },
    "8765": {
      "label": "Kwai verificação de identidade (privado)",
      "onAutoForward": "notify",
      "protocol": "http",
      "visibility": "private"
    },
    "8766": {
      "label": "TikTok verificação e persistência (privado)",
      "onAutoForward": "notify",
      "protocol": "http",
      "visibility": "private"
    }
  },
  "remoteEnv": {
    "KWAI_EXPECTED_HANDLE": "lucasrosalem",
    "EXPECTED_TIKTOK_USERNAME": "universo.anthares",
    "ANTHARES_PERSISTENT_ROOT": "/workspaces/.anthares-private",
    "KWAI_PRIVATE_HOME": "/workspaces/.anthares-private/kwai",
    "TIKTOK_PRIVATE_HOME": "/workspaces/.anthares-private/tiktok"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": false
      }
    }
  }
}
